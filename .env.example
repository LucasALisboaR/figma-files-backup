# Variáveis obrigatórias
FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIGMA_TEAM_IDS=123456789,987654321
FIGMA_SESSION_COOKIE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Variáveis opcionais
# Diretório de saída (padrão: backups/ na raiz do repo)
# BACKUP_OUT_DIR=../../backups

# Timeout de navegação/carregamento do editor por arquivo em ms (padrão: 120000 = 2 min)
# FIGMA_DOWNLOAD_TIMEOUT=120000

# Tempo máximo para o Figma começar a enviar o arquivo depois do "Save local copy"
# em ms (padrão: 180000 = 3 min). Contado só após o clique, independente dos outros
# timeouts. Aumente em design systems / arquivos muito grandes
# FIGMA_DOWNLOAD_START_TIMEOUT=180000

# Tempo máximo de espera pelo menu hamburger em ms (padrão: 90000 = 1,5 min)
# Aumente em arquivos muito grandes, onde a barra de título demora a montar
# FIGMA_MENU_TIMEOUT=90000

# Intervalo aleatório entre um download e o próximo, em ms (padrão: 5000 a 60000).
# A faixa ampla é intencional: pausas curtas e regulares aumentam a chance de captcha
# FIGMA_DELAY_MIN=5000
# FIGMA_DELAY_MAX=60000

# Rodar o browser com interface visível (true/false, padrão: false)
# FIGMA_HEADED=false
