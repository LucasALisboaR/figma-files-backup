{
  "name": "figma-backup",
  "version": "1.0.0",
  "description": "Backup completo de arquivos .fig da empresa via Figma REST API + Playwright",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "map": "node src/index.js --map-only",
    "download": "node src/index.js --from-manifest",
    "retry": "node src/index.js --from-manifest --status failed",
    "resume": "node src/index.js --from-manifest --status pending",
    "test": "node --test src/tests"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.47.0"
  }
}
